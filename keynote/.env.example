# Do NOT put a trailing # comment on a value line, and do not quote values.
# ---- required ----
GEMINI_API_KEY=

# ---- optional: Director fallback provider (reasoning only, not image/video) ----
OPENAI_API_KEY=

# ---- camera preview (browser-owned) ----
PREVIEW_PORT=8888

# The camera preview opens in this browser. Safari, because Chrome cannot
# drive Continuity Camera (the iPhone) -- a known Chrome bug -- while Safari
# can. Set empty to use the system default browser (fine for the built-in
# camera).
PREVIEW_BROWSER=Safari

# ---- stage ----
# Said out loud the moment the film is ready. Keep it short.
READY_PHRASE=
# Set to 1 to see the full prompts and handles while developing.
DIRECTOR_VERBOSE=

# ---- opening greeting ----
# Spoken greeting before the film. INTRO_SECONDS=0 skips it.
INTRO_JA=ようこそ
# An English beat after the Japanese one. Blank = off (one beat is enough).
INTRO_EN=
INTRO_SECONDS=2.4
# Shown if no Japanese font is installed (the spoken line is unchanged).
INTRO_JA_FALLBACK=Yokoso

# ---- end credits ----
# The cast list is found automatically: $CAST_FILE, then ./cast, then ./cast.txt
CAST_FILE=

# Length: 0 = derived from the cast size, so the scroll SPEED stays readable
# whether you have 8 names or 139. Columns are automatic too (1/2/3/4).
CREDITS_SECONDS=0
CREDITS_MAX_SECONDS=20

# crawl (Star Wars) | scroll (flat fallback)
# The one heading above the cast. Change this for the next conference.
CREDITS_TITLE=AGNTCon + MCPCon Japan

CREDITS_STYLE=crawl

# Spoken over the start of the credits. Empty string = say nothing.
CREDITS_VOICE=Thank you for being part of the cast!
CREDITS_VOICE_AT=1.5

# Music: none (default) | a path to your own file | synth | film
# none | a path to your own file | synth | film
CREDITS_MUSIC=none

# Veo clips run hot. 0.85 = 15% slower, audio stretched to match.
FILM_SPEED=0.8

# ---- closing QR card ----
# Blank = built from GITHUB_REPO + GITHUB_RELEASE_TAG.
# Pre-rendered QR, so no qrcode package is needed at render time.
QR_IMAGE=./assets/qr.png
QR_URL=
QR_SECONDS=2
QR_CAPTION=Take your film home

# ---- publishing ----
GITHUB_TOKEN=
# owner/repo. A SEPARATE repo is kinder: a video of a real audience
# committed to your main project lives in its history forever.
GITHUB_REPO=
GITHUB_RELEASE_TAG=mcpcon-japan-2026

# ---- models ----  (run `make models` to see what your key can actually use)
# This is the name agentgateway knows it by, NOT the provider's model id.
# The gateway maps nano-banana -> gemini-2.5-flash-image (gateway/config.yaml).
IMAGE_MODEL=nano-banana
VIDEO_MODEL=veo-3.1-lite-generate-preview
# Veo 3.1 accepts 4, 6 or 8 seconds. 8 is the ceiling for one clip;
# FILM_SPEED stretches it further (8 @ 0.8 = 10s on screen).
VIDEO_DURATION=8
# 2 = extend the clip with a second Veo pass: 20s on screen, double the wait.
VIDEO_CLIPS=1

# ---- virtual key (agentgateway 1.5.0 budgets) ----
# NOT a provider credential. It identifies the agents to agentgateway, which
# charges the $10/day budget against it. Change it and update the keyHash in
# gateway/config.yaml:  printf '%s' "$AGW_VIRTUAL_KEY" | shasum -a 256
AGW_VIRTUAL_KEY=sk-agntcon-director-2026

# ---- wiring (leave as-is unless ports clash) ----
AGW_LLM=http://localhost:3000
AGW_MCP=http://localhost:3001/mcp
SCOUT_A2A=http://localhost:3002
DP_A2A=http://localhost:3003
VISION_MCP_PORT=8000
SCOUT_PORT=9101
DP_PORT=9102
